---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE } from '../site';

const films = await getCollection('films');
const featured = films.find((f) => f.data.featured) ?? films[0];
---

<Base>
  <section class="hero">
    <p class="eyebrow">{SITE.role}</p>
    <h1>{SITE.name}</h1>
    <p class="tagline">{SITE.tagline}</p>
    <div class="ctas">
      <a class="btn primary" href="/work">See the work</a>
      <a class="btn glass" href="/films">Watch the films</a>
    </div>
  </section>

  {
    featured && (
      <a class="now-showing glass" href={`/films/${featured.id}`}>
        <img src={featured.data.poster} alt="" width="160" height="90" />
        <span>
          <span class="eyebrow">Now showing</span>
          <strong>{featured.data.title}</strong>
          <span class="meta">
            {featured.data.year} · {featured.data.runtime}
          </span>
        </span>
      </a>
    )
  }
</Base>

<style>
  .hero {
    position: absolute;
    left: var(--gutter);
    bottom: clamp(32px, 9vh, 96px);
    max-width: min(760px, calc(100% - 2 * var(--gutter)));
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.45);
  }
  h1 {
    font-size: clamp(3.6rem, 11vw, 9rem);
    margin: 6px 0 14px;
  }
  .eyebrow {
    color: var(--ink-muted);
  }
  .tagline {
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    color: var(--ink-muted);
    max-width: 44ch;
    margin: 0 0 28px;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    height: 46px;
    padding: 0 22px;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 500;
    text-shadow: none;
    transition: transform 0.3s var(--ease);
  }
  .btn:hover {
    transform: translateY(-2px);
  }
  .primary {
    background: var(--ink);
    color: #160f08;
  }
  .now-showing {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(32px, 9vh, 96px);
    display: flex;
    gap: 14px;
    align-items: center;
    padding: 10px 18px 10px 10px;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: transform 0.3s var(--ease);
  }
  .now-showing:hover {
    transform: translateY(-2px);
  }
  .now-showing img {
    width: 120px;
    aspect-ratio: 16 / 9;
    height: auto;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }
  .now-showing > span {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .now-showing strong {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.4rem;
    line-height: 1.1;
  }
  .meta {
    font-size: 13px;
    color: var(--ink-muted);
  }

  @media (max-width: 900px) {
    .now-showing {
      display: none;
    }
  }
  @media (max-width: 700px) {
    .hero {
      bottom: 96px;
    }
  }
</style>
