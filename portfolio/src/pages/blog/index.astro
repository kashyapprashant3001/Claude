---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Panel from '../../components/Panel.astro';

const posts = (await getCollection('blog', (p) => !p.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<Base title="Journal" description="Notes on design and film.">
  <Panel title="Journal" eyebrow="Writing" size="md">
    <ul class="posts">
      {
        posts.map((p) => (
          <li>
            <a href={`/blog/${p.id}`}>
              <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
              <span class="t">{p.data.title}</span>
              <span class="d">{p.data.description}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </Panel>
</Base>

<style>
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .posts a {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 4px 24px;
    padding: 22px 0;
    border-top: 1px solid var(--glass-border);
    text-decoration: none;
  }
  time {
    grid-row: span 2;
    font-size: 13px;
    color: var(--ink-faint);
    padding-top: 6px;
  }
  .t {
    font-family: var(--font-display);
    font-size: 1.9rem;
    line-height: 1.1;
    transition: color 0.2s;
  }
  .posts a:hover .t {
    color: var(--accent);
  }
  .d {
    color: var(--ink-muted);
  }
  @media (max-width: 600px) {
    .posts a {
      grid-template-columns: 1fr;
    }
    time {
      grid-row: auto;
    }
  }
</style>
