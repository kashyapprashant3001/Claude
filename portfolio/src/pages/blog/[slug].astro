---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Panel from '../../components/Panel.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => !p.data.draft);
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const date = d.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base title={d.title} description={d.description}>
  <Panel title={d.title} back="/blog" backLabel="Journal" size="md">
    <p class="meta">
      <time datetime={d.date.toISOString()}>{date}</time>
      {d.tags.map((t) => <span class="tag">{t}</span>)}
    </p>
    <article class="prose"><Content /></article>
  </Panel>
</Base>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: -12px 0 32px;
    color: var(--ink-faint);
    font-size: 14px;
  }
  time {
    margin-right: 8px;
  }
</style>
